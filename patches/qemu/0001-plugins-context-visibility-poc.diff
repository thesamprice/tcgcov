+/*
+ * ctxdemo: per-address-space-context TB execution counts.
+ *
+ * Demonstrates the proposed context-visibility API: records how many TBs
+ * execute in each guest address-space context (e.g. the MicroBlaze MMU
+ * PID) and how many context switches were observed. Companion to the
+ * tcgcov "expose guest context to plugins" RFC.
+ *
+ * License: GNU GPL, version 2 or later.
+ */
+#include <glib.h>
+#include <stdio.h>
+#include <inttypes.h>
+
+#include <qemu-plugin.h>
+
+QEMU_PLUGIN_EXPORT int qemu_plugin_version = QEMU_PLUGIN_VERSION;
+
+#define MAX_VCPUS 64
+
+typedef struct {
+    uint64_t ctx;
+    uint64_t tbs;
+    uint64_t entries;   /* times this context was switched into */
+} CtxRec;
+
+typedef struct {
+    uint64_t ctx;
+    uint64_t *tb_count; /* cached pointer into the context's CtxRec */
+} VCPUCur;
+
+static GHashTable *ctxs;      /* ctx id -> CtxRec, guarded by lock */
+static GMutex lock;
+static VCPUCur cur[MAX_VCPUS];
+static uint64_t switches;
+static uint64_t unattributed;
+
+static CtxRec *get_ctx_rec(uint64_t ctx)
+{
+    CtxRec *rec;
+
+    g_mutex_lock(&lock);
+    rec = g_hash_table_lookup(ctxs, &ctx);
+    if (!rec) {
+        rec = g_new0(CtxRec, 1);
+        rec->ctx = ctx;
+        g_hash_table_insert(ctxs, &rec->ctx, rec);
+    }
+    g_mutex_unlock(&lock);
+    return rec;
+}
+
+static void bind_vcpu(unsigned int vcpu_index, uint64_t ctx)
+{
+    CtxRec *rec = get_ctx_rec(ctx);
+
+    rec->entries++;
+    cur[vcpu_index].ctx = ctx;
+    cur[vcpu_index].tb_count = &rec->tbs;
+}
+
+static void vcpu_init(qemu_plugin_id_t id, unsigned int vcpu_index)
+{
+    if (vcpu_index < MAX_VCPUS) {
+        bind_vcpu(vcpu_index, qemu_plugin_vcpu_ctx_id(vcpu_index));
+    }
+}
+
+static void vcpu_ctx_changed(qemu_plugin_id_t id, unsigned int vcpu_index,
+                             uint64_t ctx_id)
+{
+    if (vcpu_index < MAX_VCPUS) {
+        switches++;
+        bind_vcpu(vcpu_index, ctx_id);
+    }
+}
+
+static void vcpu_tb_exec(unsigned int vcpu_index, void *udata)
+{
+    if (vcpu_index < MAX_VCPUS && cur[vcpu_index].tb_count) {
+        (*cur[vcpu_index].tb_count)++;
+    } else {
+        unattributed++;
+    }
+}
+
+static void vcpu_tb_trans(qemu_plugin_id_t id, struct qemu_plugin_tb *tb)
+{
+    qemu_plugin_register_vcpu_tb_exec_cb(tb, vcpu_tb_exec,
+                                         QEMU_PLUGIN_CB_NO_REGS, NULL);
+}
+
+static gint cmp_tbs(gconstpointer a, gconstpointer b)
+{
+    const CtxRec *ra = a, *rb = b;
+
+    return ra->tbs < rb->tbs ? 1 : ra->tbs > rb->tbs ? -1 : 0;
+}
+
+static void plugin_exit(qemu_plugin_id_t id, void *p)
+{
+    g_autoptr(GString) out = g_string_new(NULL);
+    GList *recs = g_hash_table_get_values(ctxs);
+    GList *it;
+
+    recs = g_list_sort(recs, cmp_tbs);
+    g_string_append_printf(out,
+                           "ctxdemo: %u contexts, %" PRIu64 " context switches\n",
+                           g_hash_table_size(ctxs), switches);
+    for (it = recs; it; it = it->next) {
+        CtxRec *rec = it->data;
+
+        if (rec->ctx == QEMU_PLUGIN_CTX_UNAVAILABLE) {
+            g_string_append_printf(out,
+                                   "  ctx <unavailable>: %" PRIu64
+                                   " TB execs (%" PRIu64 " entries)\n",
+                                   rec->tbs, rec->entries);
+        } else {
+            g_string_append_printf(out,
+                                   "  ctx 0x%02" PRIx64 ": %" PRIu64
+                                   " TB execs (%" PRIu64 " entries)\n",
+                                   rec->ctx, rec->tbs, rec->entries);
+        }
+    }
+    if (unattributed) {
+        g_string_append_printf(out, "  unattributed: %" PRIu64 " TB execs\n",
+                               unattributed);
+    }
+    g_list_free(recs);
+    qemu_plugin_outs(out->str);
+}
+
+QEMU_PLUGIN_EXPORT
+int qemu_plugin_install(qemu_plugin_id_t id, const qemu_info_t *info,
+                        int argc, char **argv)
+{
+    ctxs = g_hash_table_new(g_int64_hash, g_int64_equal);
+
+    qemu_plugin_register_vcpu_init_cb(id, vcpu_init);
+    qemu_plugin_register_vcpu_ctx_changed_cb(id, vcpu_ctx_changed);
+    qemu_plugin_register_vcpu_tb_trans_cb(id, vcpu_tb_trans);
+    qemu_plugin_register_atexit_cb(id, plugin_exit, NULL);
+    return 0;
+}
