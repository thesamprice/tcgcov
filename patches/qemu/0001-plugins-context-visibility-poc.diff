+uint64_t plugin_cpu_ctx_id(CPUState *cpu)
+{
+    if (cpu->cc->plugin_ctx_id) {
+        return cpu->cc->plugin_ctx_id(cpu);
+    }
+    return QEMU_PLUGIN_CTX_UNAVAILABLE;
+}
+
+/*
+ * Disable CFI checks.
+ * The callback function has been loaded from an external library so we do not
+ * have type information
+ */
+QEMU_DISABLE_CFI
+void qemu_plugin_vcpu_ctx_changed(CPUState *cpu)
+{
+    struct qemu_plugin_cb *cb, *next;
+    enum qemu_plugin_event ev = QEMU_PLUGIN_EV_VCPU_CTX_CHANGED;
+    uint64_t ctx_id;
+
+    if (!test_bit(ev, cpu->plugin_state->event_mask)) {
+        return;
+    }
+    ctx_id = plugin_cpu_ctx_id(cpu);
+
+    QLIST_FOREACH_SAFE_RCU(cb, &plugin.cb_lists[ev], entry, next) {
+        qemu_plugin_vcpu_ctx_changed_cb_t func = cb->f.vcpu_ctx_changed;
+
+        qemu_plugin_set_cb_flags(cpu, QEMU_PLUGIN_CB_RW_REGS);
+        func(cb->ctx->id, cpu->cpu_index, ctx_id);
+        qemu_plugin_set_cb_flags(cpu, QEMU_PLUGIN_CB_NO_REGS);
+    }
 }
 
